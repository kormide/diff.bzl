load("@stardoc//stardoc:stardoc.bzl", "stardoc")
load("//diff:sync_source_file.bzl", "sync_source_file")

stardoc(
    name = "rules_doc",
    out = "rules.md.out",
    input = "//:diff.bzl",
    symbol_names = [
        "cmp",
        "diff",
        "diff3",
        "sdiff",
        "sync_source_file",
    ],
    visibility = ["//docs:__pkg__"],
    deps = ["//:diff"],
)

sync_source_file(
    name = "rules",
    out = "rules.md",
    origin = ":rules_doc",
)

stardoc(
    name = "extensions_doc",
    out = "extensions.md.out",
    input = "//diff:extensions.bzl",
    visibility = ["//docs:__pkg__"],
    deps = ["//diff:extensions"],
)

sync_source_file(
    name = "extensions",
    out = "extensions.md",
    origin = ":extensions_doc",
)
